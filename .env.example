# ── Karve agent configuration ─────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env — it controls the competition wallet.

# Competition network (the agent is built for this; leave as-is)
DELPHI_NETWORK=competition-testnet

# Testnet API key for market/position reads — generate at:
# https://delphi-api-access.gensyn.ai/
DELPHI_API_ACCESS_KEY=

# Wallet signing: the private key of the wallet registered on DoraHacks
DELPHI_SIGNER_TYPE=private_key
WALLET_PRIVATE_KEY=0x...

# ── Optional integrations ─────────────────────────────────────────────────────
# Gemini API key → enables the LLM fallback estimator (aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Discord webhook → trade/error alerts to your private channel
# KARVE_DISCORD_WEBHOOK=

# ── Strategy tunables (defaults in src/config.ts; override here if needed) ───
# Catch-up / aggressive mode (current defaults):
# KARVE_MIN_OUTCOME_PROB=0.95
# KARVE_MIN_CONFIDENCE=0.85
# KARVE_KELLY_FRACTION=0.55
# KARVE_MAX_PER_MARKET=0.30
# KARVE_MAX_PER_GROUP=0.45
# KARVE_CASH_FLOOR=0.05
# KARVE_MIN_EDGE_DETERMINISTIC=0.03
# KARVE_MIN_EDGE_CROSSMARKET=0.05
# KARVE_MIN_EDGE_FAVORITE=0.03
# KARVE_MIN_EDGE_LLM=0.08
# KARVE_FAVORITE_MIN_PROB=0.92
# KARVE_SCAN_INTERVAL_MS=120000
# KARVE_HOT_WINDOW_MS=86400000
# KARVE_SLIPPAGE_BPS=300
# KARVE_DRY_RUN=true
